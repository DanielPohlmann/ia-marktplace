{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel)\" && bash .claude/hooks/protect-branch.sh'",
            "timeout": 10,
            "statusMessage": "Verificando segurança do comando..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel)\" && bash .claude/hooks/truncation-check.sh'",
            "timeout": 5,
            "statusMessage": "Verificando truncamento de resultados..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel)\" && bash .claude/hooks/stop-verify.sh'",
            "timeout": 300,
            "statusMessage": "Verificando build do projeto..."
          }
        ]
      }
    ]
  },
  
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
